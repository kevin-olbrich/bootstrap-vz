[Unit]
Description=Expand the root partition and filesystem on boot
After=local-fs.target
Wants=local-fs.target

[Service]
ExecStart=/usr/local/sbin/expand-root DEVICE PARTITION FILESYSTEM
Type=oneshot

[Install]
WantedBy=multi-user.target
